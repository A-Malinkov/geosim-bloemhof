{
 "_written_by": "analysis/comparison/compare_scenarios.py",
 "_note": "Every value over the design site (13.24 ha) unless the label says otherwise. No overall score: the indicators are not added up, because the weights would decide the ranking.",
 "storey_rule": "storeys = max(1, round(height above ground / 3.0 m)), every building in every scenario",
 "indicators": [
  {
   "key": "dwellings",
   "theme": "Programme",
   "label": "Dwellings on the site",
   "unit": "",
   "better": "higher",
   "source": "road_metrics.json"
  },
  {
   "key": "buildings_demolished",
   "theme": "Programme",
   "label": "Buildings demolished",
   "unit": "",
   "better": "lower",
   "source": "design_massing.geojson"
  },
  {
   "key": "fsi",
   "theme": "Programme",
   "label": "FSI (floor area / site)",
   "unit": "",
   "better": null,
   "source": "3DBAG + design_massing.geojson"
  },
  {
   "key": "gsi",
   "theme": "Programme",
   "label": "GSI (footprint / site)",
   "unit": "",
   "better": null,
   "source": "3DBAG + design_massing.geojson"
  },
  {
   "key": "max_height_m",
   "theme": "Programme",
   "label": "Tallest building",
   "unit": " m",
   "better": null,
   "source": "design_massing.geojson"
  },
  {
   "key": "svf_mean",
   "theme": "Daylight",
   "label": "Sky view factor, mean",
   "unit": "",
   "better": "higher",
   "source": "svf_summary*.json"
  },
  {
   "key": "sun_mean_h_0320",
   "theme": "Daylight",
   "label": "Sun hours, equinox, mean",
   "unit": " h",
   "better": "higher",
   "source": "shadow_summary*.json"
  },
  {
   "key": "sun_under2h_0320",
   "theme": "Daylight",
   "label": "Under 2 h sun, equinox",
   "unit": "%",
   "better": "lower",
   "source": "shadow_summary*.json"
  },
  {
   "key": "sun_under2h_1221",
   "theme": "Daylight",
   "label": "Under 2 h sun, 21 Dec",
   "unit": "%",
   "better": "lower",
